# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is gitignored automatically.
# ─────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get yours at https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tiffin-tracker?retryWrites=true&w=majority

# NextAuth — set to your production URL in production
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret — generate a strong random string for production
# Run: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# Google OAuth — create credentials at https://console.cloud.google.com
# Authorized redirect URIs: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
