# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is gitignored.
#
# For Vercel deployment, set these same variables in:
# Vercel Dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get yours at https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tiffin-tracker?retryWrites=true&w=majority

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Set to your production URL. On Vercel you can OMIT this — it auto-detects.
# On localhost: http://localhost:3000
# On Vercel:    https://your-app.vercel.app
NEXTAUTH_URL=https://tiffin-tracker-ashy.vercel.app

# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# ── Google OAuth ──────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client
# 3. Authorized redirect URIs:
#      https://tiffin-tracker-ashy.vercel.app/api/auth/callback/google
#      http://localhost:3000/api/auth/callback/google  (for local dev)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
